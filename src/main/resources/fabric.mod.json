{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Colorize hitbox and nametag background based on entity's team.",
  "authors": [
    "ImToggle"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/teamcolors",
    "sources": "https://github.com/ImToggle/TeamColors",
    "issues": "https://github.com/ImToggle/TeamColors/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.imtoggle.teamcolors.TeamColorsMod"
      }
    ],
    "modmenu": [
      "me.imtoggle.teamcolors.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "teamcolors.mixins.json"
  ],
  "depends": {
    "fabric-language-kotlin": "*",
    "fabricloader": ">=0.17",
    "minecraft": "${minecraft}",
    "modmenu": "*",
    "yet_another_config_lib_v3": "*"
  }
}