{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Colorize hitbox and nametag background based on entity's team.",
  "authors": [
    "ImToggle"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/teamcolors",
    "sources": "https://github.com/ImToggle/TeamColors",
    "issues": "https://github.com/ImToggle/TeamColors/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.imtoggle.teamcolors.TeamColors"
      }
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "oneconfigv1": ">=1.1.0",
    "fabric-language-kotlin": "*"
  }
}